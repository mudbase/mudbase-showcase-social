<div class="profile-header">
  <div class="avatar-circle avatar-lg"><%= h(initials(@display_name)) %></div>
  <div>
    <h1 class="page-title" style="margin-bottom:0.35rem;"><%= h(@display_name) %></h1>
    <div class="profile-stats">
      <span><strong><%= @posts.size %></strong> <%= pluralize_count(@posts.size, "post") %></span>
      <span><strong><%= @follower_count %></strong> <%= pluralize_count(@follower_count, "follower") %></span>
      <span><strong><%= @following_count %></strong> following</span>
    </div>
  </div>

  <% if @current_user && !@is_own_profile %>
    <form action="/users/<%= h(@profile_user_id) %>/follow" method="post" class="inline-form" style="margin-left:auto;">
      <button type="submit" class="btn <%= @is_following ? "btn-outline" : "" %>">
        <%= @is_following ? "Following" : "Follow" %>
      </button>
    </form>
  <% elsif !@current_user %>
    <a class="btn" style="margin-left:auto;" href="/login">Sign in to follow</a>
  <% end %>
</div>

<div class="section">
  <h2 class="section-header">Posts</h2>
  <% if @posts.empty? %>
    <div class="empty-state">
      <p><%= @is_own_profile ? "You haven't" : "#{h(@display_name)} hasn't" %> posted anything yet.</p>
    </div>
  <% else %>
    <ul class="post-list">
      <% @posts.each do |post| %>
        <%= erb :"posts/_card", layout: false, locals: { post: post } %>
      <% end %>
    </ul>
  <% end %>
</div>

# ── Mudbase project (public — a project/collection ID is not a secret) ─────
# Every value below is read client-side via EXPO_PUBLIC_* (Expo's convention
# for env vars that are safe to bundle into the app binary). Every request
# this app makes authenticates with a JWT (an anonymous session for guests, a
# real session after sign-in) - there is no server-only secret anywhere in
# this app, so nothing needs to live outside EXPO_PUBLIC_*.
EXPO_PUBLIC_MUDBASE_URL=https://cloud.mudbase.dev
EXPO_PUBLIC_MUDBASE_PROJECT_ID=
EXPO_PUBLIC_POSTS_COLLECTION_ID=
EXPO_PUBLIC_COMMENTS_COLLECTION_ID=
EXPO_PUBLIC_LIKES_COLLECTION_ID=
EXPO_PUBLIC_FOLLOWS_COLLECTION_ID=

@page
@model MudbaseShowcase.Social.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h4 fw-semibold">Something went wrong</h1>
<p class="text-muted">An unexpected error occurred while handling your request.</p>

@if (Model.ShowRequestId)
{
    <p class="text-muted small">
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<a class="btn btn-brand" asp-page="/Index">Back to the feed</a>

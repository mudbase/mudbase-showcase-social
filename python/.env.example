# ── Mudbase project ──────────────────────────────────────────────────────
# Same provisioned Mudbase project as the reference web/ app in this repo —
# see web/README.md "Provisioning" for what must already exist (local auth,
# Multi-Role with the default `customer` role, the four collections below,
# all granted create/read/update/delete, dataScope "all", to `customer`).
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
POSTS_COLLECTION_ID=
COMMENTS_COLLECTION_ID=
LIKES_COLLECTION_ID=
FOLLOWS_COLLECTION_ID=

# ── Session cookie (server-only — never expose to the browser as JS) ───────
# Signs the itsdangerous/Starlette session cookie that holds the Mudbase JWT,
# refresh token, and user profile server-side. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
SESSION_COOKIE_NAME=mudbase_showcase_social_session
# Set to "true" behind HTTPS in production so the session cookie is Secure.
SESSION_HTTPS_ONLY=false

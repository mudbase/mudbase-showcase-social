# ── Mudbase project (public — a project/collection ID is not a secret) ─────
NEXT_PUBLIC_MUDBASE_PROJECT_ID=
NEXT_PUBLIC_MUDBASE_URL=https://cloud.mudbase.dev
# Project-level publishable key (pk_ prefix). Safe to expose client-side — kept here for
# parity with the platform's dashboard and for forward-compatibility, but as of this build
# it is NOT accepted by any cloud.mudbase.dev auth middleware (`authOrApiKey` only recognizes
# `X-API-Key`/`Authorization: Bearer ak_*` values issued via the org-level API Keys feature,
# a different mechanism from this project-level `pk_` field). Every request in this app
# authenticates with a JWT instead (anonymous session for guests, real session after signup)
# — see src/lib/mudbase.ts and plan/build-plan.md "Known limitations".
NEXT_PUBLIC_MUDBASE_API_KEY=
NEXT_PUBLIC_POSTS_COLLECTION_ID=
NEXT_PUBLIC_COMMENTS_COLLECTION_ID=
NEXT_PUBLIC_LIKES_COLLECTION_ID=
NEXT_PUBLIC_FOLLOWS_COLLECTION_ID=
